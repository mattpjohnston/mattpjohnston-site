---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = [...(await getCollection("blog"))].sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const formatDate = (date: Date) =>
	new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric" }).format(date);
---

<BaseLayout
	pageTitle="Writing"
	pageDescription="Notes on infrastructure, AWS and whatever I'm building at the time."
>
	<section class="border-b border-rule py-14 md:py-20">
		<h1 class="text-3xl md:text-4xl">Writing</h1>
		<p class="mt-5 text-ink-muted">
			Notes on infrastructure, AWS and whatever I'm building at the time.
		</p>
	</section>

	{
		posts.length === 0 ? (
			<p class="py-12 text-ink-muted md:py-16">Nothing published yet.</p>
		) : (
			<ul class="divide-y divide-rule">
				{posts.map((post) => (
					<li class="py-7">
						<article>
							<h2 class="text-xl">
								<a href={`/blog/${post.id}/`} class="plain">
									{post.data.title}
								</a>
							</h2>
							<p class="mt-2 font-sans text-sm text-ink-faint">
								<time datetime={post.data.pubDate.toISOString()}>
									{formatDate(post.data.pubDate)}
								</time>
							</p>
							<p class="mt-3 text-ink-muted">{post.data.description}</p>
						</article>
					</li>
				))}
			</ul>
		)
	}
</BaseLayout>
