---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="Page not found">
	<section class="py-20 md:py-28">
		<p class="eyebrow">Error 404</p>
		<h1 class="mt-3 text-3xl md:text-4xl">Page not found</h1>
		<p class="mt-5 text-ink-muted">
			That page doesn't exist, or it has moved. The <a href="/">homepage</a> is the best place
			to start again.
		</p>
	</section>
</BaseLayout>
