---
import VisitorCounter from "./VisitorCounter.astro";
import { site } from "../site";

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-rule">
	<div
		class="mx-auto flex w-full max-w-3xl flex-wrap items-baseline justify-between gap-x-6 gap-y-2 px-5 py-6 font-sans text-sm text-ink-muted md:px-6"
	>
		<p>&copy; {year} {site.name}</p>

		<ul class="flex flex-wrap items-baseline gap-x-5 gap-y-2">
			{
				site.links.map((link) => (
					<li>
						<a href={link.href} rel="me noopener">
							{link.label}
						</a>
					</li>
				))
			}
			<li>
				<a href={`mailto:${site.email}`}>{site.email}</a>
			</li>
			<li>
				<VisitorCounter />
			</li>
		</ul>
	</div>
</footer>
