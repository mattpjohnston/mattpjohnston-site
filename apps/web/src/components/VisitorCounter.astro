---
// no env var locally, so show something rather than an empty footer
const configured = Boolean(import.meta.env.PUBLIC_COUNTER_API_URL);
---

<span data-visitor-count class="tabular-nums" aria-live="polite" hidden={configured}>
	{configured ? "" : "visits unavailable"}
</span>

<script>
	const el = document.querySelector<HTMLElement>("[data-visitor-count]");
	const url = import.meta.env.PUBLIC_COUNTER_API_URL ?? "";

	function render(count: number) {
		if (!el) return;
		el.textContent = `${count.toLocaleString("en-GB")} visits`;
		el.hidden = false;
	}

	async function getCount() {
		try {
			const res = await fetch(url, { signal: AbortSignal.timeout(10_000) });
			if (!res.ok) return null;

			const data = await res.json();
			const count = Number(data?.count);
			return Number.isFinite(count) ? count : null;
		} catch {
			return null;
		}
	}

	if (el && url) {
		const cached = Number(sessionStorage.getItem("visitor-count"));
		if (cached > 0) render(cached);

		// the lambda cold starts often enough that one attempt isn't enough
		for (let attempt = 0; attempt < 4; attempt++) {
			const count = await getCount();

			if (count !== null) {
				sessionStorage.setItem("visitor-count", String(count));
				render(count);
				break;
			}

			if (attempt < 3) await new Promise((r) => setTimeout(r, 1000 * 2 ** attempt));
		}
	}
</script>
